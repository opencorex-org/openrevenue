{
    "name": "openrevenue",
    "private": true,
    "packageManager": "pnpm@10.14.0",
    "engines": {
        "node": "22.23.1",
        "pnpm": "10.14.0"
    },
    "scripts": {
        "build": "turbo run build",
        "dev": "turbo run dev",
        "lint": "turbo run lint",
        "typecheck": "turbo run typecheck",
        "test": "turbo run test",
        "contracts": "redocly lint contracts/openapi/*.yaml --extends recommended && redocly bundle contracts/openapi/openapi.yaml --output .contract-openapi.json && node scripts/ci/validate-openapi.mjs .contract-openapi.json && node scripts/ci/validate-event-schemas.mjs && node scripts/ci/generate-openapi-client.mjs .contract-openapi.json --check && tsc --noEmit --strict --lib ES2022,DOM clients/typescript/openapi-client.ts",
        "contracts:generate": "redocly bundle contracts/openapi/openapi.yaml --output .contract-openapi.json && node scripts/ci/generate-openapi-client.mjs .contract-openapi.json",
        "contracts:compat": "node scripts/ci/check-openapi-compatibility.mjs",
        "format": "prettier --write \"apps/**/*.{ts,tsx}\" \"web/**/*.{ts,tsx}\"",
        "format:check": "prettier --check \"apps/**/*.{ts,tsx}\" \"web/**/*.{ts,tsx}\""
    },
    "devDependencies": {
        "@redocly/cli": "2.43.2",
        "ajv": "8.20.0",
        "ajv-formats": "3.0.1",
        "prettier": "^3.6.2",
        "turbo": "^2.10.8",
        "typescript": "^7.0.2"
    }
}
