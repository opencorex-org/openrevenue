# Production shape only. The referenced files are injected by the deployment
# platform from a managed secret service; this file contains no credentials.
OPENREVENUE_ENV=production
HTTP_ADDR=:8080
TLS_TERMINATED=true
DATABASE_URL_FILE=/run/secrets/openrevenue-database-url
OIDC_CLIENT_SECRET_FILE=/run/secrets/openrevenue-oidc-client
S3_CREDENTIALS_FILE=/run/secrets/openrevenue-object-storage
OTEL_EXPORTER_OTLP_ENDPOINT=https://otel-collector.platform.example
